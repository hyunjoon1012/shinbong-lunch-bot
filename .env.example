# ============================================================
#  이 파일은 "예시" 입니다.
#
#  1. 이 파일을 복사해서 이름을 .env 로 바꾸세요.
#  2. .env 파일에 실제 값을 적으세요.
#  3. .env 파일은 절대 남에게 보내지 마세요. (비밀번호와 같습니다)
#     카톡으로 보내는 것도, 인터넷에 올리는 것도 안 됩니다.
# ============================================================

# NEIS 인증키 (없어도 됩니다)
#   없으면 하루에 보낼 수 있는 요청 수가 적지만, 연습에는 충분합니다.
#   발급받고 싶다면: https://open.neis.go.kr
NEIS_API_KEY=

# 발표용 안전장치 (지금은 사용하지 않습니다)
#   true 로 하면 인터넷 없이 samples/meal.json 을 사용하게 만들 수 있습니다.
DEMO_MODE=false
